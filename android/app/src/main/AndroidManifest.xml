<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- Só para saber se o Wi-Fi está ligado. Desligado, o diálogo de procurar
         o robô simplesmente não abre, e ninguém entende por quê. Permissão
         normal: o Android não pergunta nada a quem instala. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Do Android 11 em diante um app só enxerga os outros que declara aqui.
         Sem isto o TextToSpeech não acha motor nenhum e a voz fica muda, sem
         erro — o mesmo silêncio que o Voz.kt veio consertar. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/rede_permitida"
        android:supportsRtl="false"
        android:theme="@style/Theme.AppCompat.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
